{
	"name": "kwela-api",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"test": "node --experimental-strip-types --test \"tests/*.test.mjs\"",
		"check": "tsc --noEmit",
		"db:migrate:local": "wrangler d1 migrations apply kwela --local",
		"db:migrate:remote": "wrangler d1 migrations apply kwela --remote"
	},
	"dependencies": {
		"@openai/agents": "^0.21.0",
		"mammoth": "^1.13.0",
		"zod": "^4.6.7"
	},
	"packageManager": "pnpm@10.28.2",
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261024.1",
		"typescript": "^7.0.2",
		"wrangler": "^4.152.0"
	}
}
