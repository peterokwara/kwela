{
    "name": "kwela-api",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-22",
    "compatibility_flags": ["nodejs_compat"],
    "vars": {
        "USAGE_CAP_USD": "5",
        "GLOBAL_USAGE_CAP_USD": "25",
        "MAX_REQUESTS_PER_MINUTE": "4",
        "INPUT_PRICE_PER_MILLION_USD": "0.10",
        "OUTPUT_PRICE_PER_MILLION_USD": "0.50",
        "GOOGLE_WEB_CLIENT_ID": "250576903408-s5euv3sidr3s91nnk14gb32428jc7bnj.apps.googleusercontent.com",
        "AUTH_TEST_EMAILS": "ojakaapeter@gmail.com,cliff.gor.dev@gmail.com,ojakaapeter+kwela-scenarios@gmail.com,crazsich@gmail.com"
    },
    "observability": { "enabled": true },
    "browser": {
        "binding": "BROWSER",
        "remote": true
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "kwela",
            "database_id": "09a40714-224c-4e35-9054-adeac23ec618",
            "migrations_dir": "migrations"
        }
    ],
    "r2_buckets": [
        { "binding": "RUN_INPUTS", "bucket_name": "kwela-run-inputs" }
    ],
    "workflows": [
        { "name": "kwela-chat-runs", "binding": "CHAT_RUNS", "class_name": "ChatRunWorkflow", "default_retention": { "success_retention": "26 hours", "error_retention": "26 hours" } }
    ],
    "triggers": { "crons": ["*/15 * * * *"] }
}
