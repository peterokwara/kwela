{
	"name": "kwela-site",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite build && wrangler dev .svelte-kit/cloudflare/_worker.js",
		"deploy": "vite build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "node --experimental-strip-types --test \"tests/*.test.mjs\""
	},
	"packageManager": "pnpm@10.28.2",
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"wrangler": "^4.152.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
