{
    "name": "kwela-site",
    "main": ".svelte-kit/cloudflare/_worker.js",
    "compatibility_date": "2026-10-22",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "binding": "ASSETS",
        "directory": ".svelte-kit/cloudflare"
    },
    "services": [{ "binding": "API", "service": "kwela-api" }]
}
